<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SectionHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/muted_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="OptionSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">@color/body_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TierCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">32dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/muted_text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
